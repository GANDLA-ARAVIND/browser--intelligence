{
  "name": "browser-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first browsing-history knowledge base. Phase 0: validation harness.",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "sanity": "tsx scripts/sanity.ts",
    "export-history": "node --no-warnings scripts/export-history.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "build": "vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch",
    "check-extension": "node scripts/check-extension.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@xenova/transformers": "^2.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
