{
  "manifest_version": 3,
  "name": "Browser Intelligence",
  "version": "0.1.0",
  "description": "Turns your browsing history into a searchable personal knowledge base. Everything runs on your machine.",
  "minimum_chrome_version": "116",
  "permissions": [
    "history",
    "storage",
    "offscreen",
    "alarms",
    "favicon"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Intelligence",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
